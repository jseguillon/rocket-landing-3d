{
  "name": "rocket-landing-3d",
  "version": "0.1.0",
  "description": "Immersive 3D JavaScript animation of a reusable rocket landing",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write src tests .github README.md",
    "format:check": "prettier --check src tests .github README.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual:test": "playwright test",
    "visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.5",
    "pngjs": "^7.0.0",
    "prettier": "3.9.6",
    "vite": "5.4.21",
    "vitest": "1.6.1"
  },
  "dependencies": {
    "three": "0.160.1"
  }
}
